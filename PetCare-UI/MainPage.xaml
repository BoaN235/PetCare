<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PetCare.UI.MainPage">


    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="#ADD7F6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="DarkBlue" />
            <Setter Property="TextColor" Value="#ADD7F6" />
            <Setter Property="BorderColor" Value="#62c6f1" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="ProgressColor" Value="#87BFFF" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="PlaceholderColor" Value="#ADD7F6" />
            <Setter Property="TextColor" Value="#ADD7F6" />
        </Style>
        <Style TargetType="Frame">
            <Setter Property="Background" Value="#2667FF" />
            <Setter Property="BorderColor" Value="#3F8EFC" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <!-- Background -->
        <Grid
            Padding="10,10" 
            BackgroundColor="#1C1F33">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Frame Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="5" Padding="10">
                <VerticalStackLayout>
                    <Label
                Text="Pet Care GPT"
                Style="{StaticResource Headline}"
                TextColor="White"
                SemanticProperties.HeadingLevel="Level1" />
                    <HorizontalStackLayout
                    Padding="2,2"
                    
                    HorizontalOptions="Center">
                        <Button x:Name="newgamebtn" Text="New Game" Clicked="OnNewGameClicked" Margin="2,2"></Button>
                        <Button x:Name="loadbtn" Text="Load Game" Clicked="OnLoadClicked" Margin="2,2"></Button>
                        <Button x:Name="savebtn" Text="Save Game" Clicked="OnSaveClicked" Margin="2,2"></Button>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Log -->
            <Frame  Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                BorderColor="#62c6f1"
                CornerRadius="5"
                Padding="10"
                BackgroundColor="#0094ff"
                HasShadow="False" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Frame 
                        BorderColor="#62c6f1"
                        CornerRadius="5"
                        BackgroundColor="Transparent"
                        Padding="0"
                        Grid.Row="0">
                        <ScrollView MaximumHeightRequest="300">
                            <VerticalStackLayout  x:Name="LogBox" Margin="5">
                                <Label    
                                x:Name="log"
                                Text="Hi"
                                SemanticProperties.HeadingLevel="Level3" />

                            </VerticalStackLayout>
                        </ScrollView>
                    </Frame>


                    <Grid Grid.Row="1" Padding="7,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    

                    <ScrollView Orientation="Horizontal" Grid.Column="0">
                        <Entry
                x:Name="ChatInput"
                Placeholder="Enter your message to the AI here">
                        </Entry>
                    </ScrollView>

                    <Button
                            Grid.Column="1" Grid.Row="1"
                            Text="🗣️"
                            Clicked="OnAiChatClicked">
                    </Button>
                    </Grid>
                </Grid>
            </Frame>


            <!-- Left Box -->
            <Frame     Grid.Column="0" Grid.Row="2" 
                    BorderColor="#62c6f1"
                    CornerRadius="5"
                    Padding="10"
                    BackgroundColor="#0094ff"
                    HasShadow="False" Margin="5">
                <VerticalStackLayout
                        Spacing="10">


                    <!-- Actions section -->
                    <Label
                            Text="Actions:"
                            SemanticProperties.HeadingLevel="Level2" FontSize="Large"/>
                    <!-- Actions content -->
                    <Frame 
                            BorderColor="#62c6f1"
                            CornerRadius="5"
                            BackgroundColor="Transparent"
                            Padding="0">
                        <ScrollView 
                            HeightRequest="150"
                            WidthRequest="150"
                            Margin="10"

>
                            <VerticalStackLayout 
                            x:Name="ActionBox" Spacing="2">

                            </VerticalStackLayout>
                        </ScrollView>
                    </Frame>
                    <VerticalStackLayout>
                        <!-- Stats section -->


                        
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Frame>


            <!-- Right Box -->
            <Frame Grid.Column="1" Grid.Row="2" 
        BorderColor="#62c6f1"
        CornerRadius="5"
        Padding="10"
        BackgroundColor="#0094ff"
        HasShadow="False" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                        x:Name="weekLabel"
                        Text="Week&#x0a;X"
                        HorizontalTextAlignment="Center"
                        SemanticProperties.HeadingLevel="Level2" FontSize="Large" />


                    <Label Text="Stats:" Grid.Row="1" Grid.Column="0" />
                    <Label Text="$X" x:Name="MoneyLabel" FontSize="12" Grid.Row="1" Grid.Column="2"/>



                    <Label Text="Health" FontSize="12" Grid.Row="2" Grid.Column="0"  Margin="0, 5"/>
                    <ProgressBar x:Name="HealthBar" Progress="0.65" Grid.Row="2" Grid.Column="2" Margin="0, 5"/>

                    <Label Text="Mood" FontSize="12" Grid.Row="3" Grid.Column="0"  Margin="0, 5"/>
                    <ProgressBar x:Name="HappyBar" Progress="0.35" Grid.Row="3" Grid.Column="2"  Margin="0, 5"/>

                    <Label Text="Hunger" FontSize="12" Grid.Row="4" Grid.Column="0"  Margin="0, 5" />
                    <ProgressBar x:Name="HungerBar" Progress="0.75"  Grid.Row="4" Grid.Column="2" />


                    <Button x:Name="nextweekbtn" Text="Next Day" Clicked="OnNextWeekClicked" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="Center" VerticalOptions="End"></Button>

                </Grid>
            </Frame>
        </Grid>
    </ScrollView>

</ContentPage>